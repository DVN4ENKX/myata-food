////////////////////////////////////////////////////////////////////////////////
// HTTP-сервис ОбменМята_HTTPСервис1 (корневой URL: myata).
//
// Myata отправляет сюда XML-пакет обмена: POST /hs/myata/ПриёмСообщения
// Ожидается тело application/xml в кодировке UTF-8.
// Ответ - JSON со счётчиками принятых объектов.
////////////////////////////////////////////////////////////////////////////////

Функция ПриёмСообщения(Запрос) Экспорт
	Настройки = ОбменМята_ОбщийМодуль1.Настройки();

	Если НЕ ОбменМята_ОбщийМодуль1.ПроверитьПароль(Запрос, Настройки) Тогда
		Возврат ОтветJSON(401, "{""ok"":false,""error"":""не авторизован""}");
	КонецЕсли;

	Тело = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Итог = ОбменМята_ОбщийМодуль1.ПринятьСообщение(Тело);

	Возврат ОтветJSON(?(Итог.ok, 200, 400), ОбменМята_ОбщийМодуль1.ТелоJSON(Итог));
КонецФункции

// Ответ с пустым телом: удобно для проверки доступности.
Функция Проверка(Запрос) Экспорт
	Возврат ОтветJSON(200, "{""ok"":true,""service"":""ОбменМята_HTTPСервис1""}");
КонецФункции

Функция ОтветJSON(Код, СтрокаJSON) Экспорт
	Ответ = Новый HTTPСервисОтвет(Код);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(СтрокаJSON, КодировкаТекста.UTF8, "application/json");
	Возврат Ответ;
КонецФункции
