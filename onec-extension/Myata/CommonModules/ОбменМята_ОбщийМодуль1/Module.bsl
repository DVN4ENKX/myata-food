////////////////////////////////////////////////////////////////////////////////
// Обмен с web-приложением Myata.
//
// Направления:
//   1С -> Myata : номенклатура и группы номенклатуры (POST JSON, токен Bearer).
//   Myata -> 1С : XML-пакет принимается веб-сервисом и разбирается здесь.
//
// Реквизиты настроек лежат в регистре сведений (имя уточняется по метаданным).
// Модуль серверный: и клиентские методы, и вызов веб-сервиса выполняются на сервере.
////////////////////////////////////////////////////////////////////////////////

#Область Настройки

// Имена измерений регистра настроек.
Функция КлючНастройки(Имя) Экспорт
	Возврат Имя;
КонецФункции

// Возвращает имя регистра настроек. Сначала пробуем известные имена,
// затем ищем регистр по структуре (измерение Имя + ресурс Значение),
// чтобы переименование объекта в Конфигураторе не ломало настройки.
Функция ИмяРегистраНастроек() Экспорт
	Для Каждого Имя Из СтрРазделить("ОбменМята_РегистрСведений1,НастройкиОбменаMyata,ОбменМята_РегистрСведений", ",") Цикл
		Если Реквизит("РегистрСведений", Имя) Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;

	Попытка
		Для Каждого Регистр Из Метаданные.РегистрыСведений Цикл
			ЕстьИмя = Ложь;
			ЕстьЗначение = Ложь;
			Для Каждого Измерение Из Регистр.Измерения Цикл
				Если Измерение.Имя = "Имя" Тогда
					ЕстьИмя = Истина;
				КонецЕсли;
			КонецЦикла;
			Для Каждого Ресурс Из Регистр.Ресурсы Цикл
				Если Ресурс.Имя = "Значение" Тогда
					ЕстьЗначение = Истина;
				КонецЕсли;
			КонецЦикла;
			Если ЕстьИмя И ЕстьЗначение Тогда
				Возврат Регистр.Имя;
			КонецЕсли;
		КонецЦикла;
	Исключение
		// метаданные недоступны - работаем только по именам
	КонецПопытки;

	Возврат "";
КонецФункции

// Читает все настройки обмена в виде структуры.
Функция Настройки() Экспорт
	Результат = Новый Структура;
	Результат.Вставить("АдресСервера", "");     // https://myata.ru
	Результат.Вставить("Логин", "");            // пользователь Myata с ролью «Отчёт»
	Результат.Вставить("Пароль", "");
	Результат.Вставить("ПутьОбмена", "/api/admin/integration/1c/push");
	Результат.Вставить("ПутьВхода", "/api/auth/login");
	Результат.Вставить("Токен", "");            // если задан — вход не выполняется
	Результат.Вставить("ИмяСервиса", "ОбменМята_HTTPСервис1");
	Результат.Вставить("ИмяМетода", "ПриёмСообщения");
	Результат.Вставить("ЛогинСервиса", "");    // basic auth на веб-сервис Myata -> 1С
	Результат.Вставить("ПарольСервиса", "");
	Результат.Вставить("ПроверятьПарольСервиса", Ложь);
	Результат.Вставить("Таймаут", 30);
	Результат.Вставить("ОтправлятьНоменклатуру", Истина);
	Результат.Вставить("ОтправлятьГруппы", Истина);
	Результат.Вставить("ОграничитьКоличество", 0);
	Результат.Вставить("СоздаватьЧекККМ", Ложь);
	Результат.Вставить("Организация", "");
	Результат.Вставить("Склад", "");
	Результат.Вставить("Продавец", "");
	Результат.Вставить("Валюта", "");
	Результат.Вставить("СтатусыДляЧеков", "closed,served");

	ИмяРегистра = ИмяРегистраНастроек();
	Если ПустаяСтрока(ИмяРегистра) Тогда
		Возврат Результат;
	КонецЕсли;

	Выборка = РегистрыСведений[ИмяРегистра].Выбрать();
	Пока Выборка.Следующий() Цикл
		Имя = СокрЛП(Выборка.Имя);
		Если Результат.Свойство(Имя, Значение) Тогда
			// Значения приходят строками - приводим к типу настроек.
			Если ТипЗнч(Значение) = Тип("Строка") Тогда
				Текст = СокрЛП(Значение);
				Если ТипЗнч(Результат[Имя]) = Тип("Булево") Тогда
					Значение = (Низ(Текст) = "да" Или Низ(Текст) = "истина" Или Низ(Текст) = "true" Или Текст = "1");
				ИначеЕсли ТипЗнч(Результат[Имя]) = Тип("Число") Тогда
					Если Низ(Текст) = "да" Или Низ(Текст) = "истина" Или Низ(Текст) = "true" Тогда
						Значение = 1;
					ИначеЕсли Низ(Текст) = "нет" Или Низ(Текст) = "ложь" Или Низ(Текст) = "false" Тогда
						Значение = 0;
					Иначе
						Попытка
							Значение = Число(Текст);
						Исключение
							Значение = 0;
						КонецПопытки;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Результат[Имя] = Значение;
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
КонецФункции

// Сохраняет переданные значения в регистр настроек.
Процедура СохранитьНастройки(Значения) Экспорт
	ИмяРегистра = ИмяРегистраНастроек();
	Если ПустаяСтрока(ИмяРегистра) Тогда
		ВызватьИсключение "Нет регистра настроек расширения. Создайте регистр сведений с измерением Имя и ресурсом Значение.";
	КонецЕсли;

	Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Набор.Записать();

	Для Каждого КлючИЗначение Из Значения Цикл
		Название = СокрЛП(КлючИЗначение.Ключ);
		Если ПустаяСтрока(Название) Тогда
			Продолжить;
		КонецЕсли;
		Запись = Набор.Добавить();
		Запись.Имя = Название;
		Запись.Значение = Строка(КлючИЗначение.Значение);
	КонецЦикла;
	Набор.Записать();
КонецПроцедуры

// Проверяет наличие реквизита метаданных, не вызывая исключений.
Функция Реквизит(ТипОбъекта, ИмяОбъекта, ИмяРеквизита = "") Экспорт
	Попытка
		Если НЕ ЗначениеЗаполнено(Метаданные.Найди(Тип(ТипОбъекта + "." + ИмяОбъекта))) Тогда
			Возврат Ложь;
		КонецЕсли;
		Если ПустаяСтрока(ИмяРеквизита) Тогда
			Возврат Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Метаданные.Свойство(Метаданные.Найди(Тип(ТипОбъекта + "." + ИмяОбъекта)), ИмяРеквизита)) Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область Прочие

Процедура ЗаписатьЖурнал(Уровень, Сообщение) Экспорт
	ЗаписьЖурналаРегистрации(
		"Myata.ОбменС1С",
		Уровень,
		,
		,
		Сообщение);
КонецПроцедуры

Функция ЗначениеРеквизита(Объект, ИмяРеквизита, ЗначениеПоУмолчанию = Неопределено) Экспорт
	// Безопасное чтение реквизита: свойства может не быть в конкретной сборке.
	Попытка
		Если Объект[ИмяРеквизита] <> Неопределено Тогда
			Возврат Объект[ИмяРеквизита];
		КонецЕсли;
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

// Склеивает список значений в строку через запятую - так ждёт Myata.
Функция СписокВСтроку(Коллекция) Экспорт
	Части = Новый Массив;
	Для Каждого Элемент Из Коллекция Цикл
		Если ЗначениеЗаполнено(Элемент) Тогда
			Части.Добавить(Строка(Элемент));
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");
КонецФункции

Функция ЗначениеАтрибута(Узел, Имя) Экспорт
	Попытка
		Карта = Узел.Атрибуты;
		Если Карта = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Значение = Карта[Имя];
		Если Значение = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(Значение);
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция Логическое(Узел, Имя) Экспорт
	Возврат Низ(СокрЛП(ЗначениеАтрибута(Узел, Имя))) = "true";
КонецФункции

Функция ЧислоАтрибута(Узел, Имя, ЗначениеПоУмолчанию = 0) Экспорт
	СтрокаАтрибута = СокрЛП(ЗначениеАтрибута(Узел, Имя));
	Если ПустаяСтрока(СтрокаАтрибута) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Попытка
		Возврат Число(СтрокаАтрибута);
	Исключение
		Возврат ЗначениеПоУмолчанию;
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область HTTP

// Разбирает настроенный адрес на схему, хост и префикс пути.
// "https://myata.ru/myata" -> Защищенное = Истина, Хост = "myata.ru", Префикс = "/myata".
Функция РазобратьАдрес(Адрес) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Хост", "");
	Результат.Вставить("Защищенное", Ложь);
	Результат.Вставить("Префикс", "");

	Остаток = СокрЛП(Адрес);
	Если ПустаяСтрока(Остаток) Тогда
		Возврат Результат;
	КонецЕсли;

	Если Низ(Лев(Остаток, 8)) = "https://" Тогда
		Результат.Защищенное = Истина;
		Остаток = Сред(Остаток, 9);
	ИначеЕсли Низ(Лев(Остаток, 8)) = "http://" Тогда
		Остаток = Сред(Остаток, 8);
	КонецЕсли;

	ПозицияСлэша = СтрНайти(Остаток, "/");
	Если ПозицияСлэша = 0 Тогда
		Результат.Хост = Остаток;
	Иначе
		Результат.Хост = Лев(Остаток, ПозицияСлэша - 1);
		Результат.Префикс = СокрЛПП(Сред(Остаток, ПозицияСлэша), "/");
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Адрес сервиса всегда абсолютный: схема и хост задаются в настройках.
Функция АдресСервера(Настройки) Экспорт
	Возврат СокрЛП(Настройки.АдресСервера);
КонецФункции

Функция НовыйHTTPСоединение(Настройки) Экспорт
	Части = РазобратьАдрес(Настройки.АдресСервера);
	Если ПустаяСтрока(Части.Хост) Тогда
		ВызватьИсключение "Не задан адрес сервера Myata в настройках обмена.";
	КонецЕсли;

	// Пятый параметр - таймаут, шестой - признак защищённого соединения.
	Соединение = Новый HTTPСоединение(
		Части.Хост,
		,
		,
		,
		Число(Настройки.Таймаут),
		Части.Защищенное);
	Соединение.Заголовки.Вставить("User-Agent", "1C-UNF-Myata-Exchange/1.0");
	Возврат Соединение;
КонецФункции

// Путь запроса с учётом префикса из настроек.
Функция ПолныйПуть(Настройки, Путь) Экспорт
	Части = РазобратьАдрес(Настройки.АдресСервера);
	Префикс = Части.Префикс;
	Если ПустаяСтрока(Префикс) Тогда
		Возврат Путь;
	КонецЕсли;
	Возврат Префикс + Путь;
КонецФункции

// Возвращает access_token, обновляя его при ошибке 401.
Функция Токен(Настройки, Обновить = Ложь) Экспорт
	Если Не Обновить И ЗначениеЗаполнено(Настройки.Токен) Тогда
		Возврат Настройки.Токен;
	КонецЕсли;
	Если ПустаяСтрока(Настройки.Логин) Тогда
		ВызватьИсключение "Не задан логин для входа в Myata.";
	КонецЕсли;

	Соединение = НовыйHTTPСоединение(Настройки);
	Запрос = Новый HTTPЗапрос(ПолныйПуть(Настройки, Настройки.ПутьВхода));
	Запрос.Метод = "POST";
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Тело = Новый Структура;
	Тело.Вставить("username", Настройки.Логин);
	Тело.Вставить("password", Настройки.Пароль);
	Запрос.УстановитьТело(ТелоJSON(Тело));

	Ответ = Соединение.ВызватьHTTPМетод(Запрос);
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение "Не удалось войти в Myata: код " + Ответ.КодСостояния + " " + Локально(Ответ);
	КонецЕсли;

	Данные = JSONЗначение(Ответ.ПолучитьТелоКакСтроку());
	Токен = Данные["access_token"];
	Если ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "В ответе на вход нет access_token.";
	КонецЕсли;
	Настройки.Токен = Токен;
	ЗаписатьНастройку("Токен", Токен);
	Возврат Токен;
КонецФункции

Функция Локально(Ответ, Ограничение = 500) Экспорт
	Текст = "";
	Попытка
		Текст = СокрЛП(Ответ.ПолучитьТелоКакСтроку());
	Исключение
	КонецПопытки;
	Если Текст = "" Тогда
		Текст = Строка(Ответ.КодСостояния);
	КонецЕсли;
	Если СтрДлина(Текст) > Ограничение Тогда
		Текст = Лев(Текст, Ограничение) + "...";
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Сериализует структуру/массив в JSON без перевода ключей.
Функция ТелоJSON(Значение) Экспорт
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	Настройки = Новый НастройкиСериализацииJSON;
	Настройки.ФорматДаты = ФорматДатыJSON.ISO;
	ЗаписатьJSON(Запись, Значение, Настройки);
	Возврат Строка(Запись);
КонецФункции

Функция JSONЗначение(СтрокаJSON) Экспорт
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(СтрокаJSON);
	Возврат ПрочитатьJSON(Чтение, Истина);
КонецФункции

Процедура ЗаписатьНастройку(Имя, Значение)
	ИмяРегистра = ИмяРегистраНастроек();
	Если ПустаяСтрока(ИмяРегистра) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Набор.Отбор.Имя.Установить(СокрЛП(Имя));
		Запись = Набор.Добавить();
		Запись.Имя = СокрЛП(Имя);
		Запись.Значение = Строка(Значение);
		Набор.Записать();
	Исключение
		ЗаписатьЖурнал(УровниЖурналаРегистрации.Предупреждение,
			"Не удалось сохранить настройку " + Имя + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ПриёмСообщенийОтMyata

// Проверяет basic auth на входе в веб-сервис.
Функция ПроверитьПароль(Запрос, Настройки) Экспорт
	Если НЕ Настройки.ПроверятьПарольСервиса Тогда
		Возврат Истина;
	КонецЕсли;
	Если ПустаяСтрока(Настройки.ЛогинСервиса) Тогда
		Возврат Истина;
	КонецЕсли;

	ЗначениеЗаголовка = Запрос.Заголовки.Получить("Authorization");
	Если ПустаяСтрока(ЗначениеЗаголовка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Низ(Лев(ЗначениеЗаголовка, 6)) <> "basic " Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Расшифровано = Base64Значение(СокрЛП(Сред(ЗначениеЗаголовка, 7)));
	Исключение
		Возврат Ложь;
	КонецПопытки;

	ПозицияДвоеточия = СтрНайти(Расшифровано, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Логин = Лев(Расшифровано, ПозицияДвоеточия - 1);
	Пароль = Сред(Расшифровано, ПозицияДвоеточия + 1);

	Возврат (Логин = Настройки.ЛогинСервиса И Пароль = Настройки.ПарольСервиса);
КонецФункции

// Разбирает пакет Myata и раскладывает данные по объектам 1С.
// Возвращает структуру со счётчиками и текстом последней ошибки.
Функция ПринятьСообщение(ТелоЗапроса) Экспорт
	Итог = Новый Структура;
	Итог.Вставить("ok", Ложь);
	Итог.Вставить("plan", "");
	Итог.Вставить("message_id", "");
	Итог.Вставить("groups", 0);
	Итог.Вставить("dishes", 0);
	Итог.Вставить("groups_in", 0);
	Итог.Вставить("services", 0);
	Итог.Вставить("orders", 0);
	Итог.Вставить("items", 0);
	Итог.Вставить("day_closes", 0);
	Итог.Вставить("tables", 0);
	Итог.Вставить("receipts", 0);
	Итог.Вставить("receipts_skipped", 0);
	Итог.Вставить("errors", Новый Массив);

	Если ПустаяСтрока(СокрЛП(ТелоЗапроса)) Тогда
		Ошибка(Итог, "Пустое тело запроса.");
		Возврат Итог;
	КонецЕсли;

	// Настройки передаются по цепочке вызовов, а не через Итог:
	// в ответе не должно быть пароля и токена.
	НастройкиОбмена = Настройки();

	Попытка
		Корень = РазобратьXML(ТелоЗапроса);
	Исключение
		Ошибка(Итог, "XML не разобран: " + ОписаниеОшибки());
		Возврат Итог;
	КонецПопытки;

	Если Корень.Имя <> "СообщениеОбмена" Тогда
		Ошибка(Итог, "Ожидался элемент СообщениеОбмена, получен " + Корень.Имя + ".");
		Возврат Итог;
	КонецЕсли;

	Итог.plan = ЗначениеАтрибута(Корень, "ПланОбмена");
	Итог.message_id = ЗначениеАтрибута(Корень, "Ид");

	Для Каждого Группа Из Корень.Элементы Цикл
		Если Группа.Имя <> "Группа" Тогда
			Продолжить;
		КонецЕсли;
		Итог.groups = Итог.groups + 1;
		ИмяГруппы = ЗначениеАтрибута(Группа, "Имя");

		Если ИмяГруппы = "Справочник.НоменклатураГруппы" Тогда
			Для Каждого Узел Из Группа.Элементы Цикл
				Если Узел.Имя = "НоменклатураГруппа" Тогда
					ЗаписатьГруппуНоменклатуры(Узел, Итог);
				КонецЕсли;
			КонецЦикла;

		ИначеЕсли ИмяГруппы = "Справочник.Номенклатура" Тогда
			// Модификаторы приходят в том же справочнике: их отличает Услуга="true".
			Для Каждого Узел Из Группа.Элементы Цикл
				Если Узел.Имя <> "Номенклатура" Тогда
					Продолжить;
				КонецЕсли;
				Если Логическое(Узел, "Услуга") Тогда
					ЗаписатьМодификатор(Узел, Итог);
				Иначе
					ЗаписатьНоменклатуру(Узел, Итог);
				КонецЕсли;
			КонецЦикла;

		ИначеЕсли ИмяГруппы = "Справочник.Столы" Тогда
			Для Каждого Узел Из Группа.Элементы Цикл
				Если Узел.Имя = "Стол" Тогда
					ЗаписатьСтол(Узел, Итог);
				КонецЕсли;
			КонецЦикла;

		ИначеЕсли ИмяГруппы = "Документ.ЗаказПокупателя" Тогда
			Для Каждого Узел Из Группа.Элементы Цикл
				Если Узел.Имя = "ЗаказПокупателя" Тогда
					ЗаписатьЗаказ(Узел, Итог, НастройкиОбмена);
				КонецЕсли;
			КонецЦикла;

		ИначеЕсли ИмяГруппы = "Отчет.ЗакрытиеДня" Тогда
			Для Каждого Узел Из Группа.Элементы Цикл
				Если Узел.Имя = "ЗакрытиеДня" Тогда
					ЗаписатьЗакрытиеДня(Узел, Итог);
				КонецЕсли;
			КонецЦикла;

		Иначе
			Ошибка(Итог, "Неизвестная группа: " + ИмяГруппы);
		КонецЕсли;
	КонецЦикла;

	Итог.ok = Итог.errors.Количество() = 0;
	ЗаписатьЖурнал(ЕслиТогда(Итог.ok,
			УровниЖурналаРегистрации.Информация,
			УровниЖурналаРегистрации.Предупреждение),
		"Принято сообщение " + Итог.message_id + " (план " + Итог.plan + "): "
		+ "номенклатура " + Итог.dishes + ", услуги " + Итог.services
		+ ", группы " + Итог.groups_in + ", заказы " + Итог.orders
		+ ", закрытия " + Итог.day_closes + ", столы " + Итог.tables
		+ ", ошибок " + Итог.errors.Количество() + ".");

	Возврат Итог;
КонецФункции

Процедура Ошибка(Итог, Текст)
	Итог.ok = Ложь;
	Итог.errors.Добавить(Текст);
	ЗаписатьЖурнал(УровниЖурналаРегистрации.Ошибка, Текст);
КонецПроцедуры

Функция РазобратьXML(СтрокаXML) Экспорт
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(СтрокаXML);
	Возврат ПрочитатьXML(Чтение);
КонецФункции

#КонецОбласти

#Область ЗаписьОбъектов

// Ищет группу номенклатуры по коду, создаёт при необходимости.
Функция НайтиСоздатьГруппу(Код, Наименование) Экспорт
	Ссылка = Справочники.НоменклатураГруппы.ПустаяСсылка();
	Если ЗначениеЗаполнено(Код) Тогда
		Найдено = Справочники.НоменклатураГруппы.НайтиПоНаименованию(Наименование, Истина);
		Если Найдено <> Неопределено И ЗначениеЗаполнено(Найдено) Тогда
			Возврат Найдено;
		КонецЕсли;
	КонецЕсли;

	НовыйОбъект = Справочники.НоменклатураГруппы.СоздатьЭлемент();
	Попытка
		НовыйОбъект.Наименование = Наименование;
		Если Реквизит("Справочник", "НоменклатураГруппы", "Код") Тогда
			НовыйОбъект.Код = Наименование;
		КонецЕсли;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Исключение
		Возврат Ссылка;
	КонецПопытки;
КонецФункции

Процедура ЗаписатьГруппуНоменклатуры(Узел, Итог)
	Наименование = ЗначениеАтрибута(Узел, "Наименование");
	Если ПустаяСтрока(Наименование) Тогда
		Ошибка(Итог, "НоменклатураГруппа без наименования.");
		Возврат;
	КонецЕсли;
	НайтиСоздатьГруппу(ЗначениеАтрибута(Узел, "Код"), Наименование);
	Итог.groups_in = Итог.groups_in + 1;
КонецПроцедуры

// Ищет номенклатуру по артикулу, иначе по наименованию, иначе создаёт.
Функция НайтиСоздатьНоменклатуру(Код, Артикул, Наименование, Описание) Экспорт
	Если ЗначениеЗаполнено(Артикул) И Реквизит("Справочник", "Номенклатура", "Артикул") Тогда
		Найдено = Справочники.Номенклатура.НайтиПоРеквизиту("Артикул", Артикул);
		Если Найдено <> Неопределено И ЗначениеЗаполнено(Найдено) Тогда
			Возврат Найдено;
		КонецЕсли;
	КонецЕсли;

	Найдено = Справочники.Номенклатура.НайтиПоНаименованию(Наименование, Истина);
	Если Найдено <> Неопределено И ЗначениеЗаполнено(Найдено) Тогда
		Возврат Найдено;
	КонецЕсли;

	НовыйОбъект = Справочники.Номенклатура.СоздатьЭлемент();
	НовыйОбъект.Наименование = Наименование;
	Попытка
		Если ЗначениеЗаполнено(Артикул) И Реквизит("Справочник", "Номенклатура", "Артикул") Тогда
			НовыйОбъект.Артикул = Артикул;
		КонецЕсли;
		Если ЗначениеЗаполнено(Описание) И Реквизит("Справочник", "Номенклатура", "Описание") Тогда
			НовыйОбъект.Описание = Описание;
		КонецЕсли;
		Если ЗначениеЗаполнено(Код) И Реквизит("Справочник", "Номенклатура", "Код") Тогда
			НовыйОбъект.Код = Код;
		КонецЕсли;
		НовыйОбъект.Записать();
		Возврат НовыйОбъект.Ссылка;
	Исключение
		Возврат Справочники.Номенклатура.ПустаяСсылка();
	КонецПопытки;
КонецФункции

// Записывает блюдо: цена, признаки доступности, описание.
Процедура ЗаписатьНоменклатуру(Узел, Итог)
	Наименование = ЗначениеАтрибута(Узел, "Наименование");
	Если ПустаяСтрока(Наименование) Тогда
		Ошибка(Итог, "Номенклатура без наименования.");
		Возврат;
	КонецЕсли;

	Артикул = ЗначениеАтрибута(Узел, "Артикул");
	Код = ЗначениеАтрибута(Узел, "Код");
	Описание = "";
	Попытка
		Описание = СокрЛП(Узел.Значение);
	Исключение
		Описание = "";
	КонецПопытки;

	Номенклатура = НайтиСоздатьНоменклатуру(Код, Артикул, Наименование, Описание);
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Ошибка(Итог, "Не удалось записать номенклатуру " + Наименование);
		Возврат;
	КонецЕсли;

	Цена = ЧислоАтрибута(Узел, "ЦенаНДС", 0);
	УстановитьЦену(Номенклатура, Цена);

	// Признаки, о которых Myata знает, а в УНФ могут называться иначе.
	ЗаписатьРеквизитЕслиЕсть(Номенклатура, "ВМеню", Логическое(Узел, "ВМеню"));
	ЗаписатьРеквизитЕслиЕсть(Номенклатура, "ПечатьВQRКоде", Логическое(Узел, "ПоказыватьВQR"));
	ЗаписатьРеквизитЕслиЕсть(Номенклатура, "ВМенюQR", Логическое(Узел, "ПоказыватьВQR"));
	ЗаписатьРеквизитЕслиЕсть(Номенклатура, "Доступно", Логическое(Узел, "Доступно"));

	Итог.dishes = Итог.dishes + 1;
КонецПроцедуры

// Модификатор - это тоже элемент справочника Номенклатура, помеченный Услуга.
Процедура ЗаписатьМодификатор(Узел, Итог)
	Наименование = ЗначениеАтрибута(Узел, "Наименование");
	Если ПустаяСтрока(Наименование) Тогда
		Ошибка(Итог, "Модификатор без наименования.");
		Возврат;
	КонецЕсли;

	Номенклатура = НайтиСоздатьНоменклатуру(
		ЗначениеАтрибута(Узел, "Код"), "", Наименование, "");
	Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
		Ошибка(Итог, "Не удалось записать модификатор " + Наименование);
		Возврат;
	КонецЕсли;

	УстановитьЦену(Номенклатура, ЧислоАтрибута(Узел, "ЦенаНДС", 0));
	ЗаписатьРеквизитЕслиЕсть(Номенклатура, "ВМеню", Логическое(Узел, "Активен"));
	Итог.services = Итог.services + 1;
КонецПроцедуры

Процедура ЗаписатьСтол(Узел, Итог)
	Наименование = ЗначениеАтрибута(Узел, "Наименование");
	Если ПустаяСтрока(Наименование) Тогда
		Ошибка(Итог, "Стол без наименования.");
		Возврат;
	КонецЕсли;
	Итог.tables = Итог.tables + 1;
КонецПроцедуры

// Заказ из Myata - источник для чека ККМ; сам заказ в 1С по-прежнему не создаётся.
// Заказы из Myata - источник для чека ККМ.
Процедура ЗаписатьЗаказ(Узел, Итог, НастройкиОбмена)
	Номер = ЗначениеАтрибута(Узел, "Номер");
	Если ПустаяСтрока(Номер) Тогда
		Ошибка(Итог, "Заказ без номера.");
		Возврат;
	КонецЕсли;
	Итог.orders = Итог.orders + 1;
	Итог.items = Итог.items + Узел.Элементы.Количество();

	Если НЕ НастройкиОбмена.СоздаватьЧекККМ Тогда
		Возврат;
	КонецЕсли;
	Если НЕ СтатусПодходитДляЧека(ЗначениеАтрибута(Узел, "Статус"), НастройкиОбмена) Тогда
		Возврат;
	КонецЕсли;

	СоздатьЧекККМ(Узел, Итог, НастройкиОбмена);
КонецПроцедуры

Процедура ЗаписатьЗакрытиеДня(Узел, Итог)
	Дата = ЗначениеАтрибута(Узел, "Дата");
	Если ПустаяСтрока(Дата) Тогда
		Ошибка(Итог, "Закрытие дня без даты.");
		Возврат;
	КонецЕсли;
	Итог.day_closes = Итог.day_closes + 1;
КонецПроцедуры

#Область ЧекиККМ

// Состав реквизитов чека в разных версиях УНФ разный, поэтому он ищется в runtime.

// Возвращает объект метаданных документа по имени.
Функция МетаданныеДокумента(ИмяДокумента) Экспорт
	Результат = Неопределено;
	Попытка
		Для Каждого Объект Из Метаданные.Документы Цикл
			Если Объект.Имя = ИмяДокумента Тогда
				Результат = Объект;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	Возврат Результат;
КонецФункции

// Проверяет наличие реквизита у документа или табличной части.
Функция ЕстьРеквизитУ(МетаОбъекта, ИмяРеквизита) Экспорт
	Если МетаОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Для Каждого Реквизит Из МетаОбъекта.Реквизиты Цикл
			Если Реквизит.Имя = ИмяРеквизита Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	Исключение
	КонецПопытки;
	Возврат Ложь;
КонецФункции

// Первое имя реквизита, которое реально есть в объекте метаданных.
Функция ПервоеПодходящееИмя(МетаОбъекта, Имена) Экспорт
	Для Каждого Имя Из Имена Цикл
		Если ЕстьРеквизитУ(МетаОбъекта, Имя) Тогда
			Возврат Имя;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

// Табличная часть чека с позициями: сначала типовые имена, затем по составу реквизитов.
Функция ТабличнаяЧастьПозиций(МетаДокумента) Экспорт
	Если МетаДокумента = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого Имя Из СтрРазделить("Товары,ТоварыИУслуги,Строки,Позиции", ",") Цикл
		Для Каждого Часть Из МетаДокумента.ТабличныеЧасти Цикл
			Если Часть.Имя = Имя Тогда
				Возврат Часть;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	// Типовых имён может не оказаться: берём первую часть с реквизитом номенклатуры.
	Для Каждого Часть Из МетаДокумента.ТабличныеЧасти Цикл
		Если ЕстьРеквизитУ(Часть, "Номенклатура")
			Или ЕстьРеквизитУ(Часть, "Товар") Тогда
			Возврат Часть;
		КонецЕсли;
	КонецЦикла;

	Возврат Неопределено;
КонецФункции

// Ищет элемент одного из справочников-кандидатов по наименованию.
Функция НайтиСсылкуПоНаименованию(ИменаСправочников, ИмяЗначения) Экспорт
	ИмяЗначения = СокрЛП(ИмяЗначения);
	Если ПустаяСтрока(ИмяЗначения) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ИмяСправочника Из ИменаСправочников Цикл
		Попытка
			Найдено = Справочники[ИмяСправочника].НайтиПоНаименованию(ИмяЗначения);
			Если ЗначениеЗаполнено(Найдено) Тогда
				Возврат Найдено;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Заполняет ссылочный реквизит чека, если он есть и значение найдено.
Процедура ПрименитьРеквизит(Объект, МетаОбъекта, ИмяРеквизита, ИменаСправочников, ИмяЗначения)
	Если ПустаяСтрока(СокрЛП(ИмяЗначения)) Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЕстьРеквизитУ(МетаОбъекта, ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	Значение = НайтиСсылкуПоНаименованию(ИменаСправочников, ИмяЗначения);
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		ЗаписатьЖурнал(УровниЖурналаРегистрации.Предупреждение,
			"Не найден элемент " + ИмяЗначения + " для реквизита " + ИмяРеквизита + " чека ККМ.");
		Возврат;
	КонецЕсли;
	ЗаписатьРеквизитЕслиЕсть(Объект, ИмяРеквизита, Значение);
КонецПроцедуры

// Пустой список статусов в настройках означает "любой".
Функция СтатусПодходитДляЧека(Статус, НастройкиОбмена) Экспорт
	Список = СокрЛП(НастройкиОбмена.СтатусыДляЧеков);
	Если ПустаяСтрока(Список) Тогда
		Возврат Истина;
	КонецЕсли;
	Для Каждого Элемент Из СтрРазделить(Список, ",") Цикл
		Если СокрЛП(Элемент) = СокрЛП(Статус) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

// Уже созданный чек по этому заказу: защита от повторной загрузки.
Функция НайтиЧекПоМаркеру(Маркер) Экспорт
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЧекККМ.Ссылка
			|ИЗ Документ.ЧекККМ КАК ЧекККМ
			|ГДЕ ЧекККМ.Комментарий ПОДОБНОЕ &Маркер");
		Запрос.УстановитьПараметр("Маркер", "%" + Маркер + "%");
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

// Только чтение: чек не должен заводить новые элементы номенклатуры.
Функция НайтиНоменклатуру(Код, Наименование) Экспорт
	ПустоеЗначение = Справочники.Номенклатура.ПустаяСсылка();
	Условие = "";
	Если НЕ ПустаяСтрока(СокрЛП(Код)) Тогда
		Условие = "Номенклатура.Код ПОДОБНОЕ &Код";
	КонецЕсли;
	Если НЕ ПустаяСтрока(СокрЛП(Наименование)) Тогда
		Если ПустаяСтрока(Условие) Тогда
			Условие = "Номенклатура.Наименование = &Наименование";
		Иначе
			Условие = Условие + " ИЛИ Номенклатура.Наименование = &Наименование";
		КонецЕсли;
	КонецЕсли;
	Если ПустаяСтрока(Условие) Тогда
		Возврат ПустоеЗначение;
	КонецЕсли;
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Номенклатура.Ссылка
			|ИЗ Справочник.Номенклатура КАК Номенклатура
			|ГДЕ НЕ Номенклатура.ЭтоГруппа И (" + Условие + ")");
		Запрос.УстановитьПараметр("Код", "%" + СокрЛП(Код) + "%");
		Запрос.УстановитьПараметр("Наименование", СокрЛП(Наименование));
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			Выборка = Результат.Выбрать();
			Если Выборка.Следующий() Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат ПустоеЗначение;
КонецФункции

// Создаёт черновик чека ККМ: без проведения и без фискализации.
Процедура СоздатьЧекККМ(Узел, Итог, НастройкиОбмена)
	НомерЗаказа = СокрЛП(ЗначениеАтрибута(Узел, "Номер"));
	Маркер = "[Myata:" + НомерЗаказа + "]";

	Если ЗначениеЗаполнено(НайтиЧекПоМаркеру(Маркер)) Тогда
		Итог.receipts_skipped = Итог.receipts_skipped + 1;
		Возврат;
	КонецЕсли;

	Мета = МетаданныеДокумента("ЧекККМ");
	Если Мета = Неопределено Тогда
		Ошибка(Итог, "В конфигурации нет документа ЧекККМ.");
		Возврат;
	КонецЕсли;

	МетаЧасти = ТабличнаяЧастьПозиций(Мета);
	Если МетаЧасти = Неопределено Тогда
		Ошибка(Итог, "У документа ЧекККМ не найдена табличная часть позиций.");
		Возврат;
	КонецЕсли;

	ИмяНоменклатуры = ПервоеПодходящееИмя(МетаЧасти, СтрРазделить("Номенклатура,Товар", ","));
	Если ПустаяСтрока(ИмяНоменклатуры) Тогда
		Ошибка(Итог, "В табличной части " + МетаЧасти.Имя + " нет реквизита номенклатуры.");
		Возврат;
	КонецЕсли;
	ИмяКоличества = ПервоеПодходящееИмя(МетаЧасти, СтрРазделить("Количество,КолВест,КолВо", ","));
	ИмяЦены = ПервоеПодходящееИмя(МетаЧасти, СтрРазделить("Цена,ЦенаЗаЕдиницу", ","));
	ИмяСуммы = ПервоеПодходящееИмя(МетаЧасти, СтрРазделить("Сумма", ","));

	Док = Документы.ЧекККМ.СоздатьДокумент();
	Док.Дата = ТекущаяДатаСеанса();
	Если ЕстьРеквизитУ(Мета, "Комментарий") Тогда
		Док.Комментарий = Маркер + " заказ Myata " + НомерЗаказа;
	КонецЕсли;
	ПрименитьРеквизит(Док, Мета, "Склад", СтрРазделить("Склады,МестаХранения", ","), НастройкиОбмена.Склад);
	ПрименитьРеквизит(Док, Мета, "Продавец", СтрРазделить("Сотрудники,Менеджеры", ","), НастройкиОбмена.Продавец);
	ПрименитьРеквизит(Док, Мета, "Валюта", СтрРазделить("Валюты", ","), НастройкиОбмена.Валюта);
	ПрименитьРеквизит(Док, Мета, "Организация", СтрРазделить("Организации", ","), НастройкиОбмена.Организация);

	ЗаписаноСтрок = 0;
	Для Каждого СтрокаТовара Из Узел.Элементы Цикл
		Если СтрокаТовара.Имя <> "Товар" Тогда
			Продолжить;
		КонецЕсли;
		Номенклатура = НайтиНоменклатуру(
			ЗначениеАтрибута(СтрокаТовара, "Код"),
			ЗначениеАтрибута(СтрокаТовара, "Наименование"));
		Если НЕ ЗначениеЗаполнено(Номенклатура) Тогда
			Продолжить;
		КонецЕсли;
		Количество = ЧислоАтрибута(СтрокаТовара, "Количество", 0);
		Если Количество <= 0 Тогда
			Количество = 1;
		КонецЕсли;
		Цена = ЧислоАтрибута(СтрокаТовара, "Цена", 0);
		СтрокаЧека = Док[МетаЧасти.Имя].Добавить();
		ЗаписатьРеквизитЕслиЕсть(СтрокаЧека, ИмяНоменклатуры, Номенклатура);
		Если НЕ ПустаяСтрока(ИмяКоличества) Тогда
			ЗаписатьРеквизитЕслиЕсть(СтрокаЧека, ИмяКоличества, Количество);
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИмяЦены) Тогда
			ЗаписатьРеквизитЕслиЕсть(СтрокаЧека, ИмяЦены, Цена);
		КонецЕсли;
		Если НЕ ПустаяСтрока(ИмяСуммы) Тогда
			ЗаписатьРеквизитЕслиЕсть(СтрокаЧека, ИмяСуммы, Количество * Цена);
		КонецЕсли;
		ЗаписаноСтрок = ЗаписаноСтрок + 1;
	КонецЦикла;

	Если ЗаписаноСтрок = 0 Тогда
		Ошибка(Итог, "В заказе " + НомерЗаказа + " не найдено позиций по загруженной номенклатуре.");
		Возврат;
	КонецЕсли;

	Попытка
		Док.Записать(РежимЗаписиДокумента.Запись);
		Итог.receipts = Итог.receipts + 1;
		ЗаписатьЖурнал(УровниЖурналаРегистрации.Информация,
			"Создан чек ККМ " + Строка(Док.Ссылка) + " по заказу Myata " + НомерЗаказа + ".");
	Исключение
		Ошибка(Итог, "Не удалось записать чек ККМ по заказу " + НомерЗаказа + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#КонецОбласти


Процедура ЗаписатьРеквизитЕслиЕсть(Объект, ИмяРеквизита, Значение)
	Если Объект = Неопределено Или ПустаяСтрока(ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	// Состав реквизитов зависит от версии конфигурации - присваиваем в Попытка.
	Попытка
		Объект[ИмяРеквизита] = Значение;
	Исключение
	КонецПопытки;
КонецПроцедуры

// Цена в Myata приходит в рублях, в УНФ цены живут в регистре ЦеныНоменклатуры.
Процедура УстановитьЦену(Номенклатура, Цена)
	Если Цена <= 0 Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если НЕ Реквизит("РегистрСведений", "ЦеныНоменклатуры") Тогда
			Возврат;
		КонецЕсли;
		Набор = РегистрСведений.ЦеныНоменклатуры.СоздатьНаборЗаписей();
		Набор.Отбор.Номенклатура.Установить(Номенклатура);
		Запись = Набор.Добавить();
		Запись.Номенклатура = Номенклатура;
		Если Реквизит("РегистрСведений", "ЦеныНоменклатуры", "Цена") Тогда
			Запись.Цена = Цена;
		КонецЕсли;
		Если Реквизит("РегистрСведений", "ЦеныНоменклатуры", "ВидЦены") Тогда
			ВидЦены = Справочники.ВидыЦен.НайтиПоНаименованию("Основная цена продажи");
			Если ЗначениеЗаполнено(ВидЦены) Тогда
				Запись.ВидЦены = ВидЦены;
			КонецЕсли;
		КонецЕсли;
		Набор.Записать();
	Исключение
		ЗаписатьЖурнал(УровниЖурналаРегистрации.Предупреждение,
			"Не удалось записать цену для " + Номенклатура + ": " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

#КонецОбласти

#Область ОтправкаВMyata

// Собирает номенклатуру и группы и отправляет их в Myata.
Функция ОтправитьСправочники() Экспорт
	Настройки = Настройки();
	Если ПустаяСтрока(АдресСервера(Настройки)) Тогда
		ВызватьИсключение "Не задан адрес сервера Myata.";
	КонецЕсли;

	Ограничение = Число(Настройки.ОграничитьКоличество);
	Позиции = Новый Массив;
	Если Настройки.ОтправлятьНоменклатуру Тогда
		ДобавитьНоменклатуру(Позиции, Ограничение);
	КонецЕсли;
	Если Настройки.ОтправлятьГруппы Тогда
		ДобавитьГруппы(Позиции, Ограничение);
	КонецЕсли;

	Если Позиции.Количество() = 0 Тогда
		Возврат Новый Структура("ok", Истина);
	КонецЕсли;

	Тело = Новый Структура;
	Тело.Вставить("items", Позиции);

	Ответ = ВыполнитьЗапрос(Настройки, Настройки.ПутьОбмена, "POST",
		ТелоJSON(Тело), "application/json; charset=utf-8");
	Результат = JSONЗначение(Ответ.ПолучитьТелоКакСтроку());
	Ошибки = "";
	Попытка
		Если Результат["errors"] <> Неопределено И Результат["errors"].Количество() > 0 Тогда
			Ошибки = " ошибки: " + СтрСоединить(Результат["errors"], "; ");
		КонецЕсли;
	Исключение
	КонецПопытки;

	Принято = 0;
	Попытка
		Принято = Число(Результат["accepted"]);
	Исключение
	КонецПопытки;

	ЗаписатьЖурнал(УровниЖурналаРегистрации.Информация,
		"Отправлено в Myata позиций: " + Позиции.Количество()
		+ ", принято: " + Принято + Ошибки);

	Возврат Новый Структура("ok", Истина);
КонецФункции

Процедура ДобавитьНоменклатуру(Позиции, Ограничение)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Номенклатура.Ссылка КАК Ссылка,
		|	Номенклатура.Наименование КАК Наименование,
		|	ЕСТЬNULL(Номенклатура.Артикул, """") КАК Артикул
		|ИЗ
		|	Справочник.Номенклатура КАК Номенклатура
		|ГДЕ
		|	Номенклатура.ЭтоГруппа = ЛОЖЬ
		|	И Номенклатура.ПометкаУдаления = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	Номенклатура.Наименование");
	Если Ограничение > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "УПОРЯДОЧИТЬ ПО",
			"ПЕРВЫЕ " + Ограничение + " УПОРЯДОЧИТЬ ПО");
	КонецЕсли;

	ОшибкаЗапроса = "";
	Попытка
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		ОшибкаЗапроса = ОписаниеОшибки();
		РезультатЗапроса = Неопределено;
	КонецПопытки;

	Если РезультатЗапроса = Неопределено Тогда
		ЗаписатьЖурнал(УровниЖурналаРегистрации.Ошибка,
			"Не удалось прочитать номенклатуру: " + ОшибкаЗапроса);
		Возврат;
	КонецЕсли;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("entity", "Справочник.Номенклатура");
		Позиция.Вставить("external_id", ВнешнийИдентификатор(Выборка.Ссылка));
		Позиция.Вставить("name", СокрЛП(Выборка.Наименование));
		Позиция.Вставить("price", ЦенаНоменклатуры(Выборка.Ссылка));
		Позиция.Вставить("is_available", Истина);
		Позиция.Вставить("article", СокрЛП(Выборка.Артикул));
		Позиции.Добавить(Позицию);
	КонецЦикла;
КонецПроцедуры

Процедура ДобавитьГруппы(Позиции, Ограничение)
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	Группы.Ссылка КАК Ссылка,
			|	Группы.Наименование КАК Наименование
			|ИЗ
			|	Справочник.НоменклатураГруппы КАК Группы
			|ГДЕ
			|	Группы.ПометкаУдаления = ЛОЖЬ");
		Если Ограничение > 0 Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ГДЕ",
				"ПЕРВЫЕ " + Ограничение + " ГДЕ", 1);
		КонецЕсли;
		РезультатЗапроса = Запрос.Выполнить();
	Исключение
		ЗаписатьЖурнал(УровниЖурналаРегистрации.Предупреждение,
			"Не удалось прочитать группы номенклатуры: " + ОписаниеОшибки());
		Возврат;
	КонецПопытки;

	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Позиция = Новый Структура;
		Позиция.Вставить("entity", "Справочник.НоменклатураГруппы");
		Позиция.Вставить("external_id", ВнешнийИдентификатор(Выборка.Ссылка));
		Позиция.Вставить("name", СокрЛП(Выборка.Наименование));
		Позиции.Добавить(Позицию);
	КонецЦикла;
КонецПроцедуры

// Ключ, по которому Myata сопоставляет элемент. Артикул предпочтительнее,
// потому что он уникален и переживает переименование.
Функция ВнешнийИдентификатор(Ссылка) Экспорт
	Попытка
		Артикул = СокрЛП(Ссылка.Артикул);
		Если ЗначениеЗаполнено(Артикул) Тогда
			Возврат Артикул;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат XMLСтрока(Ссылка.УникальныйИдентификатор());
КонецФункции

// Текущая цена продажи номенклатуры.
Функция ЦенаНоменклатуры(Номенклатура) Экспорт
	Попытка
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЦеныНоменклатуры.Цена КАК Цена
			|ИЗ
			|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних КАК ЦеныНоменклатуры
			|ГДЕ
			|	ЦеныНоменклатуры.Номенклатура = &Номенклатура
			|УПОРЯДОЧИТЬ ПО
			|	ЦеныНоменклатуры.Период УБЫВ");
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Число(Выборка.Цена);
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат 0;
КонецФункции

#КонецОбласти

#Область Обмен

// Ручной запуск из формы и единственная точка входа для регламентного задания.
Процедура ВыполнитьОбмен() Экспорт
	ЗаписатьЖурнал(УровниЖурналаРегистрации.Информация, "Начат обмен с Myata.");
	Попытка
		ОтправитьСправочники();
	Исключение
		ЗаписатьЖурнал(УровниЖурналаРегистрации.Ошибка,
			"Ошибка отправки в Myata: " + ОписаниеОшибки());
	КонецПопытки;
	ЗаписатьЖурнал(УровниЖурналаРегистрации.Информация, "Обмен с Myata завершён.");
КонецПроцедуры

// Выполняет HTTP-запрос к Myata, один раз повторяя вход при 401.
Функция ВыполнитьЗапрос(Настройки, Путь, Метод, Тело, ТипСодержимого) Экспорт
	Соединение = НовыйHTTPСоединение(Настройки);
	Ответ = Отправить(Соединение, Настройки, Путь, Метод, Тело, ТипСодержимого,
		Токен(Настройки));

	Если Ответ.КодСостояния = 401 Или Ответ.КодСостояния = 403 Тогда
		Настройки.Токен = "";
		Ответ = Отправить(Соединение, Настройки, Путь, Метод, Тело, ТипСодержимого,
			Токен(Настройки, Истина));
	КонецЕсли;

	Если Ответ.КодСостояния < 200 Или Ответ.КодСостояния >= 300 Тогда
		ВызватьИсключение "Myata вернула код " + Ответ.КодСостояния + ": " + Локально(Ответ);
	КонецЕсли;
	Возврат Ответ;
КонецФункции

Функция Отправить(Соединение, Настройки, Путь, Метод, Тело, ТипСодержимого, ЗнакАвторизации) Экспорт
	Запрос = Новый HTTPЗапрос(ПолныйПуть(Настройки, Путь));
	Запрос.Метод = Метод;
	Запрос.Заголовки.Вставить("Content-Type", ТипСодержимого);
	Запрос.Заголовки.Вставить("Authorization", "Bearer " + ЗнакАвторизации);
	Если ЗначениеЗаполнено(Тело) Тогда
		Запрос.УстановитьТело(Тело);
	КонецЕсли;
	Возврат Соединение.ВызватьHTTPМетод(Запрос);
КонецФункции

#КонецОбласти

#Область ПроверкаСвязи

// Проверяет доступность Myata для формы настроек.
Функция ПроверитьСвязь() Экспорт
	Настройки = Настройки();
	Результат = Новый Структура;
	Результат.Вставить("ok", Ложь);
	Результат.Вставить("message", "");
	Попытка
		Соединение = НовыйHTTPСоединение(Настройки);
		Запрос = Новый HTTPЗапрос(ПолныйПуть(Настройки, "/api/health"));
		Запрос.Метод = "GET";
		Ответ = Соединение.ВызватьHTTPМетод(Запрос);
		Результат.ok = (Ответ.КодСостояния >= 200 И Ответ.КодСостояния < 300);
		Результат.message = "Сервер ответил кодом " + Ответ.КодСостояния + ".";
	Исключение
		Результат.message = "Связь не установлена: " + ОписаниеОшибки();
	КонецПопытки;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область Служебные

Функция ЕслиТогда(Условие, Истина, Ложь)
	Возврат ?(Условие, Истина, Ложь);
КонецФункции

Функция ОписаниеОшибки() Экспорт
	ИнформацияОбОшибке = ИнформацияОбОшибке();
	Возврат КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
КонецФункции

#КонецОбласти
