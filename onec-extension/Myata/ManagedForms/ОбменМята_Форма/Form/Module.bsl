////////////////////////////////////////////////////////////////////////////////
// Форма настройки обмена с Myata.
//
// Модуль ОбменМята_ОбщийМодуль1 серверный, поэтому все обращения к нему идут через
// методы формы &НаСервереБезКонтекста: на клиенте настройки недоступны.
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте

Перем ИтогПроверки;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Значения = ЗагрузитьНастройки();
	АдресСервера = Значения.АдресСервера;
	Логин = Значения.Логин;
	Пароль = Значения.Пароль;
	ЛогинСервиса = Значения.ЛогинСервиса;
	ПарольСервиса = Значения.ПарольСервиса;
	ПроверятьПарольСервиса = Значения.ПроверятьПарольСервиса;
	ОтправлятьНоменклатуру = Значения.ОтправлятьНоменклатуру;
	ОтправлятьГруппы = Значения.ОтправлятьГруппы;
	ОграничитьКоличество = Значения.ОграничитьКоличество;
	СоздаватьЧекККМ = Значения.СоздаватьЧекККМ;
	Организация = Значения.Организация;
	Склад = Значения.Склад;
	Продавец = Значения.Продавец;
	Валюта = Значения.Валюта;
	СтатусыДляЧеков = Значения.СтатусыДляЧеков;
	Таймаут = Значения.Таймаут;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройки(Команда)
	Значения = Новый Структура;
	Значения.Вставить("АдресСервера", АдресСервера);
	Значения.Вставить("Логин", Логин);
	Значения.Вставить("Пароль", Пароль);
	Значения.Вставить("ПроверятьПарольСервиса", ПроверятьПарольСервиса);
	Значения.Вставить("ЛогинСервиса", ЛогинСервиса);
	Значения.Вставить("ПарольСервиса", ПарольСервиса);
	Значения.Вставить("ОтправлятьНоменклатуру", ОтправлятьНоменклатуру);
	Значения.Вставить("ОтправлятьГруппы", ОтправлятьГруппы);
	Значения.Вставить("ОграничитьКоличество", ОграничитьКоличество);
	Значения.Вставить("СоздаватьЧекККМ", СоздаватьЧекККМ);
	Значения.Вставить("Организация", Организация);
	Значения.Вставить("Склад", Склад);
	Значения.Вставить("Продавец", Продавец);
	Значения.Вставить("Валюта", Валюта);
	Значения.Вставить("СтатусыДляЧеков", СтатусыДляЧеков);
	Значения.Вставить("Таймаут", Таймаут);
	// Токен сбрасываем: пароль мог измениться.
	Значения.Вставить("Токен", "");

	СохранитьНастройкиНаСервере(Значения);
	ПоказатьПредупреждение(, "Настройки сохранены.");
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСвязь(Команда)
	ИтогПроверки = ПроверитьСвязьНаСервере();
	ПоказатьПредупреждение(, ИтогПроверки.message);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	ВыполнитьОбменНаСервере();
	ПоказатьПредупреждение(, "Обмен выполнен, подробности в журнале регистрации.");
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьНастройки()
	Возврат ОбменМята_ОбщийМодуль1.Настройки();
КонецФункции

&НаСервереБезКонтекста
Процедура СохранитьНастройкиНаСервере(Значения)
	ОбменМята_ОбщийМодуль1.СохранитьНастройки(Значения);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьСвязьНаСервере()
	Возврат ОбменМята_ОбщийМодуль1.ПроверитьСвязь();
КонецФункции

&НаСервереБезКонтекста
Процедура ВыполнитьОбменНаСервере()
	ОбменМята_ОбщийМодуль1.ВыполнитьОбмен();
КонецПроцедуры
