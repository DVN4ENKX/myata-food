						<v8:Type xmlns:v8="http://v8.1c.ru/8.1/data/core">xs:decimal</v8:Type>
					</Type>
				</Properties>
			</Attribute>
			<Attribute uuid="a1b0c0d1-000b-4000-8000-000000000000">				<Properties>					<Name>СоздаватьЧекККМ</Name>					<Synonym>						<ru>Создавать чеки ККМ</ru>					</Synonym>					<Comment>						<ru>Включите, чтобы расширение создавало черновик чека ККМ по заказам Myata.</ru>					</Comment>					<Type>						<v8:Type xmlns:v8="http://v8.1c.ru/8.1/data/core">xs:boolean</v8:Type>					</Type>				</Properties>			</Attribute>			<Attribute uuid="a1b0c0d1-000c-4000-8000-000000000000">				<Properties>					<Name>Организация</Name>					<Synonym>						<ru>Организация</ru>					</Synonym>					<Comment>						<ru>Наименование организации для чеков. Оставьте пустым, если в 1С она одна.</ru>					</Comment>					<Type>						<v8:Type xmlns:v8="http://v8.1c.ru/8.1/data/core">xs:string</v8:Type>					</Type>				</Properties>			</Attribute>			<Attribute uuid="a1b0c0d1-000d-4000-8000-000000000000">				<Properties>					<Name>Склад</Name>					<Synonym>						<ru>Склад</ru>					</Synonym>					<Comment>						<ru>Наименование склада, который будет в чеках.</ru>					</Comment>					<Type>						<v8:Type xmlns:v8="http://v8.1c.ru/8.1/data/core">xs:string</v8:Type>					</Type>				</Properties>			</Attribute>			<Attribute uuid="a1b0c0d1-000e-4000-8000-000000000000">				<Properties>					<Name>Продавец</Name>					<Synonym>						<ru>Продавец</ru>					</Synonym>					<Comment>						<ru>Наименование сотрудника - продавца чека.</ru>					</Comment>					<Type>						<v8:Type xmlns:v8="http://v8.1c.ru/8.1/data/core">xs:string</v8:Type>					</Type>				</Properties>			</Attribute>			<Attribute uuid="a1b0c0d1-000f-4000-8000-000000000000">				<Properties>					<Name>Валюта</Name>					<Synonym>						<ru>Валюта</ru>					</Synonym>					<Comment>						<ru>Наименование валюты чека. Обычно определяется автоматически.</ru>					</Comment>					<Type>						<v8:Type xmlns:v8="http://v8.1c.ru/8.1/data/core">xs:string</v8:Type>					</Type>				</Properties>			</Attribute>