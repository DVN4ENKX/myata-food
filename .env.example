# ---------- Backend ----------
# Database: PostgreSQL (recommended) or SQLite for quick local run
DATABASE_URL=postgresql+psycopg://myata:myata@localhost:5432/myata_food
# DATABASE_URL=sqlite:///./storage/myata.db

SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Where the guest QR codes will point. No trailing slash.
PUBLIC_BASE_URL=http://localhost:5173
# Fallback base used only when rendering QR codes server-side
API_PUBLIC_URL=http://localhost:8000

CORS_ORIGINS=http://localhost:5173,http://localhost:8000

STORAGE_DIR=./storage
MAX_UPLOAD_MB=8

# ---------- Frontend (Vite) ----------
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# ---------- Database (docker-compose) ----------
POSTGRES_USER=myata
POSTGRES_PASSWORD=myata
POSTGRES_DB=myata_food
